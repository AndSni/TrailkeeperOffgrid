<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Location is core (GPS puck, route recording, "mark spot") - fine
         only, since every fix comes straight from GPS_PROVIDER
         (location/RawGps.kt), never the coarse network provider. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The app runs fully offline. INTERNET is only used, opportunistically,
         to stream/pre-download map regions (Settings -> Offline maps). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.TrailkeeperOffgrid">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TrailkeeperOffgrid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Receiving a .tkshare bundle (ShareBundle.kt) sent from
                 another Trailkeeper Offgrid device. Matched primarily by
                 our vendor MIME type, which survives a direct share-sheet
                 hop (Bluetooth, Quick Share, most messaging apps). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.trailkeeper.share+zip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/vnd.trailkeeper.share+zip" />
            </intent-filter>
            <!-- Fallback: a transport that saved the file to storage lost
                 the MIME type (Android has no way to register a custom
                 extension's MIME type system-wide, so it falls back to
                 octet-stream) - match by the .tkshare extension instead.
                 ShareBundle.peek() validates the manifest.json marker
                 before importing anything, so a false-positive match on an
                 unrelated file just shows an error, not a bad import. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.tkshare" />
            </intent-filter>
        </activity>

        <service
            android:name=".record.TrackRecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Lets the system camera app write a photo we can then read back,
             for the "take a new photo" option when adding a task/report photo. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
